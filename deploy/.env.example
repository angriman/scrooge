# Copy to .env next to compose.yaml and adapt. A line left out takes the value shown here.

# The image. `latest` is the newest release; a tag (`:v1.2.3`) keeps that version.
SCROOGE_IMAGE=ghcr.io/angriman/scrooge:latest

# The data folder on this machine, relative to compose.yaml or absolute: the config, the
# database and its backups, the statements kept. Make it before the first start, as the user
# below: a folder Docker makes belongs to root, and the app could not write there.
SCROOGE_DATA=./data

# The user and group that own the data folder, as numbers: `id -u` and `id -g` print them.
SCROOGE_UID=1000
SCROOGE_GID=1000

# The port of this machine the pages answer on. 127.0.0.1:8765 for this machine alone.
SCROOGE_PORT=8765
