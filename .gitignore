# Sensitive: real statements and derived data. Never commit. (Statements of a setup made
# before users/ existed were kept here.)
statements/
transactions_*.csv
# The database, its snapshots and backups, the statements kept beside it, the NAS data folder
*.db
*.db.*
*.db-*
originals/
backups/
/data/
.env
# Generated: the NAS image folder, caches of runs
output/
# Personal: rules naming shops and people, what is held, own categories, account names.
# Starters of the first three, holding nothing personal, are in src/finanze/starter/.
/rules.yaml
rules.*.yaml
/instruments.yaml
/categories.yaml
finanze.yaml
# The starter files `finanze init` copies hold nothing personal.
!/src/finanze/starter/*.yaml

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Internal docs and agent instructions: not committed for now.
docs/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/

# Tooling caches
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
mutants/

# Lock files
*.lock
!uv.lock

# Self-contained uv, its Python and caches (./uv)
/.local/

# Everything personal of each setup (finanze init): the config, rules, categories,
# instruments, statements, the database, its originals and backups
/users/
